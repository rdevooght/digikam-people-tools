# Copy to .env and adjust. Used by suspects/find_suspects.py (never committed: see .gitignore).
# Relative paths are relative to this file.

# digiKam core database (required)
DIGIKAM_DB=/path/to/digikam4.db

# digiKam face database. Optional: defaults to recognition.db next to digikam4.db
DIGIKAM_FACES_DB=/path/to/recognition.db

# Folder of your image collection (the album root). Optional, but without it
# the report lists files and faces without showing the photos.
DIGIKAM_COLLECTION=/path/to/Pictures
